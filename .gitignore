.DS_Store
.env

# Raw source files are reproducible downloads and can be large.
data/raw/**/*
!data/raw/.gitkeep

# Keep transformed tables, metrics, report inputs and reference data versioned.

# LaTeX intermediates. The compiled report PDF is tracked so it is readable on
# GitHub without a local TeX installation.
*.aux
*.fdb_latexmk
*.fls
*.out
*.synctex.gz
*.toc
*.bbl
*.blg
reports/*.log
