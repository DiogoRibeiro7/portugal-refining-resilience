root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{ipynb,csv}]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

[*.{py,toml,yml,yaml,md,json}]
indent_style = space
indent_size = 4

[*.md]
trim_trailing_whitespace = false
